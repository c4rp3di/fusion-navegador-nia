<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- T084 v2 (R0319, RES-0129): decision del usuario (R0318: abrir
         pero avisar claro). Sin esto, Android (targetSdk 34) tumba el
         socket http en silencio: el motor acepta http pero el SO lo
         bloquea (hallazgo 3.6 del informe externo). El aviso claro vive
         en el panel de identidad (PanelIdentidad.AVISO_SIN_CIFRAR) y
         mixed-content y la degradacion https a http siguen prohibidos. -->
    <application
        android:label="Navegador NIA"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- T072 v2 (R0168, RES-0078): el navegador es la pantalla inicial;
             las demos del motor quedan en MainActivity, abierta del menu. -->
        <activity
            android:name=".BrowserActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T087 v1 + T088 v1 (R0187, RES-0088/RES-0089):
                 interoperabilidad Android. SEND text/plain y VIEW
                 http/https entrantes con confirmacion en el shell;
                 sin App Links ajenos ni peticion de rol (honesto
                 hasta el smoke T067-B en dispositivo). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".DevToolsActivity"
            android:exported="false" />

        <activity
            android:name=".FetchDemoActivity"
            android:exported="false" />

        <activity
            android:name=".CatalogoActivity"
            android:exported="false" />
    </application>

</manifest>
